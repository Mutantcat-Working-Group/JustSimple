<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.mutantcat.justsimple</groupId>
        <artifactId>justsimple-parent</artifactId>
        <version>4.1.1-SNAPSHOT</version>
        <relativePath>../../../justsimple-parent/pom.xml</relativePath>
    </parent>

    <artifactId>justsimple-faas-luffy</artifactId>
    <name>${project.artifactId}</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.mutantcat.justsimple</groupId>
            <artifactId>justsimple</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mutantcat.justsimple</groupId>
            <artifactId>justsimple-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mutantcat.justsimple</groupId>
            <artifactId>justsimple-logging</artifactId>
        </dependency>

        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>luffy.base</artifactId>
            <version>${luffy.version}</version>
        </dependency>

        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon</artifactId>
            <version>${solon.version}</version>
        </dependency>

        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>luffy.executor.s.javascript</artifactId>
            <version>${luffy.version}</version>
        </dependency>

        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>wood</artifactId>
            <version>${wood.version}</version>
        </dependency>

        <dependency>
            <groupId>org.mutantcat.justsimple</groupId>
            <artifactId>justsimple-web</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mutantcat.justsimple</groupId>
            <artifactId>justsimple-logging-simple</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mutantcat.justsimple</groupId>
            <artifactId>justsimple-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- JDK 15 起 Nashorn 已从 JDK 中移除，luffy 的 javascript 执行器取不到
             ScriptEngine 会抛 NPE。这里在 JDK 15+ 给测试补上 org.openjdk.nashorn
             独立版，让 FaasTest 能继续真正校验 js 函数的执行。 -->
        <profile>
            <id>justsimple-faas-luffy-jdk15-nashorn</id>
            <activation>
                <jdk>[15,)</jdk>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.openjdk.nashorn</groupId>
                    <artifactId>nashorn-core</artifactId>
                    <version>15.7</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

</project>
