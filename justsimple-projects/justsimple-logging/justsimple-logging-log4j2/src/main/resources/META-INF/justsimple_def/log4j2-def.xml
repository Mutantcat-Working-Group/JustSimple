<?xml version="1.0" encoding="UTF-8"?>
<Configuration packages="org.apache.logging.log4j.justsimple">
    <Properties>
        <Property name="APP_NAME">${sys:justsimple.app.name:-justsimple}</Property>

        <Property name="CONSOLE_LOG_PATTERN_DEF">%highlight{%-5level %d{yyyy-MM-dd HH:mm:ss.SSS} #%5X{pid} [-%t][*%X{traceId}]%tags[%logger{20}]:} %n%msg%n</Property>
        <Property name="CONSOLE_LOG_PATTERN">${sys:justsimple.logging.appender.console.pattern:-${CONSOLE_LOG_PATTERN_DEF}}</Property>
        <Property name="CONSOLE_LOG_LEVEL">${sys:justsimple.logging.appender.console.level:-TRACE}</Property>

        <Property name="FILE_LOG_EXTENSION">${sys:justsimple.logging.appender.file.extension:-.log}</Property>
        <Property name="FILE_LOG_NAME">${sys:justsimple.logging.appender.file.name:-logs/${APP_NAME}}</Property>
        <Property name="FILE_LOG_ROLLING_DEF">${FILE_LOG_NAME}_%d{yyyy-MM-dd}_%i${FILE_LOG_EXTENSION}</Property>
        <Property name="FILE_LOG_ROLLING">${sys:justsimple.logging.appender.file.rolling:-${FILE_LOG_ROLLING_DEF}}</Property>
        <Property name="FILE_LOG_PATTERN_DEF">%-5level %d{yyyy-MM-dd HH:mm:ss.SSS} #%5X{pid} [-%t][*%X{traceId}]%tags[%logger{20}]: %n%msg%n</Property>
        <Property name="FILE_LOG_PATTERN">${sys:justsimple.logging.appender.file.pattern:-${FILE_LOG_PATTERN_DEF}}</Property>
        <Property name="FILE_LOG_LEVEL">${sys:justsimple.logging.appender.file.level:-INFO}</Property>
        <Property name="FILE_LOG_MAX_HISTORY">${sys:justsimple.logging.appender.file.maxHistory:-7}</Property>
        <Property name="FILE_LOG_MAX_FILE_SIZE">${sys:justsimple.logging.appender.file.maxFileSize:-10 MB}</Property>

        <Property name="LOGGER_ROOT_LEVEL">${sys:justsimple.logging.logger.root.level:-TRACE}</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT" follow="true">
            <PatternLayout pattern="${CONSOLE_LOG_PATTERN}"
                           disableAnsi="false"
                           noConsoleNoAnsi="false"/>
            <ThresholdFilter level="${CONSOLE_LOG_LEVEL}" onMatch="ACCEPT" onMismatch="DENY"/>
        </Console>
        <RollingFile name="File"
                     fileName="${FILE_LOG_NAME}.log"
                     filePattern="${FILE_LOG_ROLLING}">
            <ThresholdFilter level="${FILE_LOG_LEVEL}" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout>
                <Pattern>${FILE_LOG_PATTERN}</Pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="${FILE_LOG_MAX_FILE_SIZE}" />
            </Policies>
            <DefaultRolloverStrategy max="${FILE_LOG_MAX_HISTORY}"/>
        </RollingFile>
        <JustSimple name="JustSimple">
            <ThresholdFilter level="TRACE" onMatch="ACCEPT" onMismatch="DENY"/>
        </JustSimple>
    </Appenders>
    <Loggers>
        <Root level="${LOGGER_ROOT_LEVEL}">
            <AppenderRef ref="Console" />
            <AppenderRef ref="File" />
            <AppenderRef ref="JustSimple" />
        </Root>
    </Loggers>
</Configuration>
